rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return !isSignedIn() || request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Profiles Collection: /profiles/{userId}
    match /profiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Profiles are queried directly by document ID
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Subscriptions Subcollection: /users/{userId}/subscriptions/{subscriptionId}
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(subscriptionId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(subscriptionId);
    }

    // User Accounts Collection: /accounts/{accountId}
    match /accounts/{accountId} {
      allow get: if true;
      allow create, update: if isValidId(accountId);
      allow delete: if false;
    }

    // Verification OTPs: /verification_otps/{otpId}
    match /verification_otps/{otpId} {
      allow get: if isValidId(otpId);
      allow create, update: if isValidId(otpId);
      allow delete: if false;
    }
  }
}
