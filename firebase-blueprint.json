{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with onboarding financial goals and budget preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "averageMonthlyExpense": { "type": "number" },
        "financialGoal": { 
          "type": "string", 
          "enum": ["Relaxed/Informational", "Moderate Tracking", "Strict/Aggressive Budgeting"] 
        },
        "targetMonthlyBudget": { "type": "number" },
        "identity": { "type": "string" },
        "authProvider": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "fullName", "targetMonthlyBudget", "financialGoal"]
    },
    "EncryptedSubscription": {
      "title": "EncryptedSubscription",
      "description": "Client-side encrypted subscription record ensuring zero-knowledge privacy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "nameEnc": { "type": "string" },
        "costEnc": { "type": "string" },
        "nextRenewalDateEnc": { "type": "string" },
        "trialExpiryDateEnc": { "type": "string" },
        "notesEnc": { "type": "string" },
        "cancellationUrlEnc": { "type": "string" },
        "category": { "type": "string" },
        "billingCycle": { "type": "string" },
        "currency": { "type": "string" },
        "domain": { "type": "string" },
        "isPaused": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "nameEnc", "costEnc", "nextRenewalDateEnc", "category", "billingCycle"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "User credential record for password-based and phone-based authentication",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "identity": { "type": "string" },
        "identityType": { "type": "string", "enum": ["email", "phone"] },
        "passwordHash": { "type": "string" },
        "salt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "fullName", "identity", "identityType", "passwordHash", "salt"]
    },
    "VerificationOtp": {
      "title": "VerificationOtp",
      "description": "Secure verification OTP challenge for signup, login recovery, and forgot-password",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "identity": { "type": "string" },
        "identityType": { "type": "string", "enum": ["email", "phone"] },
        "purpose": { "type": "string", "enum": ["signup", "login_recovery", "forgot_password"] },
        "codeHash": { "type": "string" },
        "expiresAt": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "identity", "identityType", "purpose", "codeHash", "expiresAt"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User onboarding profile and budget limits"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "EncryptedSubscription" },
      "description": "Private client-encrypted subscriptions belonging to user"
    },
    "/accounts/{accountId}": {
      "schema": { "$ref": "UserAccount" },
      "description": "Registered user credentials and identity mapping"
    },
    "/verification_otps/{otpId}": {
      "schema": { "$ref": "VerificationOtp" },
      "description": "Active real OTP verification challenges"
    }
  }
}
